# 复制成 .env 再改：
#   cp .env.example .env
#   docker compose up -d
#
# 这个文件只放「容器起来之前」就必须知道的路径。
# 其余配置（监控目录、扫描间隔、并发数、端口…）全在页面「设置」里改，
# 存进 data/settings.json，改完即时生效，重启也不丢。

# ---------- 必填 ----------
# 宿主机上录像目录的绝对路径（要指到 xiaomi_camera_videos 这一层）
# 群晖是 /volume1/xxx，威联通是 /share/xxx，绿联是 /volume1 或 /volume2
WATCH_DIR_HOST=/volume1/Camera/xiaomi_camera_videos

# 索引、缩略图、settings.json 放在宿主机哪里
DATA_DIR_HOST=/volume1/docker/lookcam

# ---------- 环境变量里定死的 ----------
# 时区决定每条录像归到哪一天。改了要重建索引，所以不放进设置页
TZ=Asia/Shanghai
