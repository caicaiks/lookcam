# 复制成 .env 再改：cp .env.example .env
#
# 只放「容器起来之前」必须知道的东西。其余配置（扫描间隔、扫描深度、
# 并发数、缩略图…）都在页面「设置」里改，存进 data/settings.json，
# 改完即时生效，重启也不丢。
#
# ⚠️ 不要把你电脑上的 data/ 目录拷到 NAS：里面的 settings.json 记着
#    本机调试用的 SMB 挂载路径，拷过去会让 NAS 扫不到任何录像。
#    让 NAS 上的 DATA_DIR_HOST 目录保持空，第一次启动会自己建索引。

# ---------- 必填：两个宿主机绝对路径 ----------
# 录像根目录，要指到 xiaomi_camera_videos 这一层（里面能看到设备 ID 目录）。
# 群晖 /volume1/...，威联通 /share/...，绿联 /volume1 或 /volume2/...
WATCH_DIR_HOST=/volume1/Camera/xiaomi_camera_videos

# 索引、缩略图、settings.json 存哪。目录不存在会自动创建。
DATA_DIR_HOST=/volume1/docker/lookcam

# ---------- 可选 ----------
# 时区，决定每段录像归到哪一天。改了要重建索引。
TZ=Asia/Shanghai

# 对外端口（内外一致）。改完重启容器。
# 注意：请在这里改，不要只在页面的「设置」里改端口 —— 页面改的是容器内
# 监听端口，这里的 ports 映射不会跟着变，改完就连不上了。
PORT=8420

# 镜像。默认拉 GHCR 上的公开镜像；想锁版本写 :sha-<commit>；
# 若用 build-image.sh 导出的 tar.gz 在 NAS 上 docker load 过，改成 lookcam:latest
LOOKCAM_IMAGE=ghcr.io/caicaiks/lookcam:latest
